# Audio runtime for the detached player (scripts/peon_play.py).
#
# numpy is split by interpreter: the 2.2 series is the last one that publishes
# wheels for Python 3.10, while 3.11+ (and especially 3.14) need 2.3 or newer.
# Without the split, a single pin would try to build numpy from source on the
# interpreter it has no wheel for.
#
# Regenerate with:
#   uv pip compile --universal --generate-hashes --python-version 3.10 \
#       requirements.in -o requirements-uv.lock.txt
numpy>=2.2,<2.3 ; python_full_version < '3.11'
numpy>=2.3 ; python_full_version >= '3.11'
soundfile
sounddevice
